{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DB: Start SQL Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "cd \"${workspaceFolder}\" && docker compose up -d"
    },
    {
      "name": "DB: Stop SQL Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "cd \"${workspaceFolder}\" && docker compose down"
    },
    {
      "name": "DB + App: Start",
      "type": "node-terminal",
      "request": "launch",
      "command": "cd \"${workspaceFolder}\" && docker compose up -d && dotnet run"
    },
    {
      "name": "DbStart1 (Debug)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/DbStart1.csproj",
      "preLaunchTask": "Docker: Start SQL Server",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "launchBrowser": {
        "enabled": true,
        "args": "http://localhost:5036"
      }
    }
  ]
}
